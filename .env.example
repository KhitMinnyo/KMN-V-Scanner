# Copy this file to .env. Do not commit .env or API keys.
APP_NAME=KMN Vulnerability Scanner
APP_VERSION=3.0.0
HOST=127.0.0.1
PORT=2025
DATABASE_URL=data/scanner.db
MAX_SCAN_WORKERS=2
SCAN_COMMAND_TIMEOUT=900
MAX_TARGET_PORTS=65535

# Safety default: only private, loopback, and link-local targets are allowed.
ALLOW_EXTERNAL_TARGETS=false

# Optional. Leave blank to use NVD's unauthenticated, slower rate limit.
NVD_API_KEY=
