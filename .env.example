# Copy this file to .env. Do not commit .env or API keys.
APP_NAME=KMN Vulnerability Scanner
HOST=127.0.0.1
PORT=2025
DATABASE_URL=data/scanner.db
MAX_SCAN_WORKERS=2
SCAN_COMMAND_TIMEOUT=900
MAX_TARGET_PORTS=65535

# External targets require the bilingual authorization popup plus the
# per-request authorization confirmation. Use an AUTHORIZED_TARGETS allowlist
# whenever possible.
ALLOW_EXTERNAL_TARGETS=true

# Optional exact host/IP/CIDR allowlist for external targets. Leave blank to
# rely on the per-scan authorization confirmation plus the flag above.
AUTHORIZED_TARGETS=

# Optional dashboard login. Leave blank to disable password protection.
DASHBOARD_PASSWORD=

# Update Nuclei templates once in the background when the app starts.
AUTO_UPDATE_NUCLEI_TEMPLATES=true

# Trivy filesystem targets must stay inside this directory.
TRIVY_SCAN_ROOT=.

# Optional read-only SSH audit. Use a dedicated low-privilege account and key.
SSH_AUDIT_USER=
SSH_AUDIT_KEY_PATH=
SSH_AUDIT_KNOWN_HOSTS_PATH=data/ssh_known_hosts

# Optional generic webhook. Payload includes Slack text and Discord content.
NOTIFICATION_WEBHOOK_URL=
ALLOW_INSECURE_WEBHOOK=false

# Optional. Leave blank to use NVD's unauthenticated, slower rate limit.
NVD_API_KEY=
