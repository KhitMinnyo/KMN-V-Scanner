# Copy this file to .env. Do not commit .env or API keys.
APP_NAME=KMN Vulnerability Scanner
APP_VERSION=3.0.0
HOST=127.0.0.1
PORT=2025
DATABASE_URL=data/scanner.db
MAX_SCAN_WORKERS=2
SCAN_COMMAND_TIMEOUT=900
MAX_TARGET_PORTS=65535

# External targets require the bilingual authorization popup plus the
# per-request authorization confirmation. Use an AUTHORIZED_TARGETS allowlist
# whenever possible.
ALLOW_EXTERNAL_TARGETS=true

# Optional exact host/IP/CIDR allowlist for external targets. Leave blank to
# rely on the per-scan authorization confirmation plus the flag above.
AUTHORIZED_TARGETS=

# Optional. Leave blank to use NVD's unauthenticated, slower rate limit.
NVD_API_KEY=
